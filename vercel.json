{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/seo-writer",
      "destination": "/tools/seo-writer.html"
    },
    {
      "source": "/admin/seo-writer.html",
      "destination": "/tools/seo-writer.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
