---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Find featured post
const featuredPost = posts.find(post => post.data.featured) || posts[0];

// Filter out featured post from regular feed
const regularPosts = featuredPost 
  ? posts.filter(post => post.id !== featuredPost.id)
  : posts;

// Top 5 posts for trending sidebar widget
const trendingPosts = posts.slice(0, 5);

// Standard categories/labels on the site
const categories = ["AI Models", "AI Business", "AI Regulation", "Global AI", "Ai Tool and Tutorials"];

// Homepage WebSite Schema for Search Engines (SEO)
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AI Tech Safar",
  "url": "https://www.aitechsafar.com/",
  "description": "Latest AI News, Tools & Trends - Curated Daily",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.aitechsafar.com/search/label/{search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<Layout title="Latest AI News, Tools & Trends" schema={schema}>
  <div class="container">
    <div class="homepage-grid">
      <!-- Main Content Feed -->
      <div>
        {featuredPost && (
          <article class="featured-article-card">
            <div class="featured-image-wrapper">
              <a href={`/${featuredPost.id}.html`}>
                <img 
                  src={featuredPost.data.heroImage || "https://images.unsplash.com/photo-1677442136019-21780efad99a?q=80&w=1200&auto=format&fit=crop"} 
                  alt={featuredPost.data.title} 
                  class="featured-image"
                  loading="eager"
                />
              </a>
            </div>
            <div class="featured-content">
              <div class="featured-meta">
                <span class="badge">{featuredPost.data.category}</span>
                <span>•</span>
                <FormattedDate date={featuredPost.data.pubDate} />
              </div>
              <h2 class="featured-title">
                <a href={`/${featuredPost.id}.html`}>{featuredPost.data.title}</a>
              </h2>
              <p class="article-row-excerpt">{featuredPost.data.description}</p>
            </div>
          </article>
        )}

        <!-- Middle Ad Slot -->
        <div class="ad-slot-container" style="max-height: 120px; margin-bottom: 2.5rem;">
          <div class="ad-slot-label">Sponsored Content</div>
          <div class="ad-slot-display">
            <span>Responsive Ad Slot (In-Feed Banner)</span>
          </div>
        </div>

        <section class="news-feed-section">
          <div class="feed-header">
            <h3 class="feed-title">Latest Stories</h3>
          </div>

          {regularPosts.length === 0 ? (
            <p style="color: var(--text-muted); text-align: center; padding: 2rem 0;">No more articles available. Check back soon!</p>
          ) : (
            regularPosts.map(post => (
              <article class="article-row-card">
                <div class="article-row-image-wrapper">
                  <a href={`/${post.id}.html`}>
                    <img 
                      src={post.data.heroImage || "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?q=80&w=600&auto=format&fit=crop"} 
                      alt={post.data.title} 
                      class="article-row-image"
                      loading="lazy"
                    />
                  </a>
                </div>
                <div class="article-row-content">
                  <div>
                    <span class="badge purple">{post.data.category}</span>
                    <h3 class="article-row-title">
                      <a href={`/${post.id}.html`}>{post.data.title}</a>
                    </h3>
                    <p class="article-row-excerpt">{post.data.description}</p>
                  </div>
                  <div class="article-row-meta">
                    <span>By {post.data.author}</span>
                    <span>•</span>
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                </div>
              </article>
            ))
          )}
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="sidebar-wrapper">
        <!-- Ad Slot -->
        <div class="ad-slot-container" style="margin-top: 0; min-height: 250px;">
          <div class="ad-slot-label">Advertisement</div>
          <div class="ad-slot-display" style="min-height: 250px;">
            <span>Sidebar Box Ad (300x250)</span>
          </div>
        </div>

        <!-- Trending Widget -->
        <div class="sidebar-widget">
          <h4 class="widget-title">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            Trending Safar
          </h4>
          <ul class="trending-list">
            {trendingPosts.map((post, index) => (
              <li class="trending-item">
                <span class="trending-number">{String(index + 1).padStart(2, '0')}</span>
                <div class="trending-content">
                  <h5 class="trending-title">
                    <a href={`/${post.id}.html`}>{post.data.title}</a>
                  </h5>
                  <div class="trending-meta">
                    <span>{post.data.category}</span>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Categories Widget -->
        <div class="sidebar-widget">
          <h4 class="widget-title">Categories</h4>
          <div class="category-cloud">
            {categories.map(category => (
              <a href={`/search/label/${encodeURIComponent(category)}`} class="category-cloud-link">
                {category}
              </a>
            ))}
          </div>
        </div>

        <!-- Newsletter Signup Widget -->
        <div class="sidebar-widget">
          <h4 class="widget-title">Newsletter</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem;">
            Get AI Tech Safar updates directly in your inbox. No spam, only value.
          </p>
          <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed successfully!');">
            <input 
              type="email" 
              placeholder="Your email address" 
              class="newsletter-input" 
              required 
              aria-label="Email Address"
            />
            <button type="submit" class="newsletter-submit">Subscribe</button>
          </form>
        </div>
      </aside>
    </div>
  </div>
</Layout>
