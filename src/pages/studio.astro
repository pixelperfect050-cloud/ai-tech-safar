---
// Admin Studio for AI Tech Safar
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI Tech Safar — Admin Studio & Publisher</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js" is:inline></script>
  
  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111726;
      --border: #1e293b;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --accent: #10b981;
      --danger: #ef4444;
      --input-bg: #0b0f19;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Nav */
    .admin-header {
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .brand-group {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .brand-logo {
      font-size: 1.15rem;
      font-weight: 800;
      background: linear-gradient(135deg, #a5b4fc, #6366f1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .badge-studio {
      background: rgba(99, 102, 241, 0.2);
      color: #818cf8;
      border: 1px solid rgba(99, 102, 241, 0.4);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .nav-tabs {
      display: flex;
      gap: 0.5rem;
    }
    .tab-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.15s;
    }
    .tab-btn:hover {
      color: var(--text);
      background: rgba(255,255,255,0.05);
    }
    .tab-btn.active {
      color: #fff;
      background: var(--primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .btn {
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.15s;
    }
    .btn-secondary {
      background: var(--border);
      color: var(--text);
    }
    .btn-secondary:hover { background: #334155; }
    .btn-primary {
      background: var(--primary);
      color: #fff;
    }
    .btn-primary:hover { background: var(--primary-hover); }

    /* Layout Containers */
    .admin-main {
      flex: 1;
      padding: 1.5rem;
      max-width: 1600px;
      width: 100%;
      margin: 0 auto;
    }
    .tab-content {
      display: none;
    }
    .tab-content.active {
      display: block;
    }

    /* Composer Split Grid */
    .composer-grid {
      display: grid;
      grid-template-columns: 360px 1fr 1fr;
      gap: 1.25rem;
      height: calc(100vh - 120px);
    }
    @media (max-width: 1200px) {
      .composer-grid {
        grid-template-columns: 1fr;
        height: auto;
      }
    }

    .panel {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .panel-header {
      padding: 0.75rem 1rem;
      background: rgba(0,0,0,0.2);
      border-bottom: 1px solid var(--border);
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .panel-body {
      padding: 1rem;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    /* Form Fields */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .form-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .form-input, .form-select, .form-textarea {
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.6rem 0.75rem;
      color: var(--text);
      font-size: 0.9rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      border-color: var(--primary);
    }
    .form-textarea {
      resize: vertical;
      min-height: 70px;
    }

    /* Markdown Editor */
    .toolbar {
      display: flex;
      gap: 0.3rem;
      background: rgba(0,0,0,0.3);
      padding: 0.4rem 0.75rem;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .tool-btn {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
    }
    .tool-btn:hover {
      background: rgba(255,255,255,0.08);
      color: var(--text);
      border-color: var(--border);
    }
    .editor-textarea {
      flex: 1;
      background: var(--input-bg);
      color: #e2e8f0;
      border: none;
      padding: 1rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.92rem;
      line-height: 1.6;
      resize: none;
      outline: none;
      overflow-y: auto;
    }

    /* Live Preview Pane */
    .preview-pane {
      padding: 1.5rem;
      overflow-y: auto;
      color: #cbd5e1;
      line-height: 1.7;
    }
    .preview-pane h1 { font-size: 1.8rem; color: #fff; margin-bottom: 1rem; line-height: 1.25; }
    .preview-pane h2 { font-size: 1.35rem; color: #f1f5f9; margin: 1.5rem 0 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
    .preview-pane h3 { font-size: 1.15rem; color: #e2e8f0; margin: 1.2rem 0 0.5rem; }
    .preview-pane p { margin-bottom: 1rem; }
    .preview-pane blockquote { border-left: 3px solid var(--primary); padding: 0.6rem 1rem; background: rgba(99, 102, 241, 0.08); border-radius: 0 6px 6px 0; margin-bottom: 1rem; }
    .preview-pane table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.88rem; }
    .preview-pane th, .preview-pane td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
    .preview-pane th { background: rgba(255,255,255,0.04); color: #fff; }
    .preview-pane pre { background: #0b0f19; border: 1px solid var(--border); padding: 0.75rem; border-radius: 6px; overflow-x: auto; margin-bottom: 1rem; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; }

    /* Manage Posts List */
    .posts-table-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .posts-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    .posts-table th, .posts-table td {
      padding: 0.85rem 1.2rem;
      border-bottom: 1px solid var(--border);
    }
    .posts-table th {
      background: rgba(0,0,0,0.25);
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .posts-table tr:hover td {
      background: rgba(255,255,255,0.02);
    }
    .post-table-title {
      font-weight: 600;
      color: #fff;
    }

    /* Modal / Alert Notification */
    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #1e293b;
      border: 1px solid var(--border);
      color: #fff;
      padding: 0.85rem 1.25rem;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      z-index: 9999;
      display: none;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>

  <!-- Top Header -->
  <header class="admin-header">
    <div class="brand-group">
      <a href="/" class="brand-logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        AI Tech Safar
      </a>
      <span class="badge-studio">Publisher Studio</span>
    </div>

    <nav class="nav-tabs">
      <button class="tab-btn active" onclick="switchTab('composer')">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Post Composer
      </button>
      <button class="tab-btn" onclick="switchTab('posts')">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Manage Posts (<span id="post-count-badge">7</span>)
      </button>
      <button class="tab-btn" onclick="switchTab('settings')">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        GitHub / Vercel API
      </button>
    </nav>

    <div class="header-actions">
      <button class="btn btn-secondary" onclick="copyFullMarkdown()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        Copy Markdown
      </button>
      <button class="btn btn-secondary" onclick="downloadMdFile()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download .md
      </button>
      <button class="btn btn-primary" id="publish-btn" onclick="publishPost()">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        Publish to Vercel
      </button>
    </div>
  </header>

  <!-- Main Content Areas -->
  <main class="admin-main">
    
    <!-- 1. COMPOSER TAB -->
    <div id="tab-composer" class="tab-content active">
      <div class="composer-grid">
        
        <!-- Metadata Sidebar -->
        <div class="panel">
          <div class="panel-header">
            <span>Post Metadata (SEO & Frontmatter)</span>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="form-label">Article Title</label>
              <input type="text" id="post-title" class="form-input" placeholder="e.g. DeepSeek-R1 Architecture Breakdown" oninput="autoSlug()" />
            </div>

            <div class="form-group">
              <label class="form-label">URL Slug</label>
              <input type="text" id="post-slug" class="form-input" placeholder="deepseek-r1-architecture-breakdown" />
            </div>

            <div class="form-group">
              <label class="form-label">Category / Label</label>
              <select id="post-category" class="form-select">
                <option value="AI Models">AI Models</option>
                <option value="AI Business">AI Business</option>
                <option value="AI Regulation">AI Regulation</option>
                <option value="Global AI">Global AI</option>
                <option value="Ai Tool and Tutorials">Ai Tool and Tutorials</option>
                <option value="Tech News 2026">Tech News 2026</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Tags (comma-separated)</label>
              <input type="text" id="post-tags" class="form-input" placeholder="DeepSeek, Reasoning AI, LLM 2026" />
            </div>

            <div class="form-group">
              <label class="form-label">Hero Image URL</label>
              <input type="text" id="post-hero" class="form-input" value="https://images.unsplash.com/photo-1677442136019-21780efad99a?q=80&w=800&auto=format&fit=crop" />
            </div>

            <div class="form-group">
              <label class="form-label">Meta Description</label>
              <textarea id="post-desc" class="form-textarea" placeholder="Short description for Google Search & SERP..."></textarea>
            </div>

            <div style="display:flex; gap:1rem; align-items:center;">
              <label style="font-size:0.85rem; display:flex; align-items:center; gap:0.4rem; cursor:pointer;">
                <input type="checkbox" id="post-featured" /> Featured on Homepage
              </label>
            </div>

            <div class="form-group">
              <label class="form-label">Author</label>
              <input type="text" id="post-author" class="form-input" value="AI Tech Safar" />
            </div>
          </div>
        </div>

        <!-- Markdown Code Editor -->
        <div class="panel">
          <div class="panel-header">
            <span>Markdown Content</span>
            <span id="word-count" style="color:var(--text-muted); font-size:0.75rem;">0 words</span>
          </div>
          <div class="toolbar">
            <button class="tool-btn" onclick="insertMd('## ')">H2</button>
            <button class="tool-btn" onclick="insertMd('### ')">H3</button>
            <button class="tool-btn" onclick="insertMd('**', '**')">Bold</button>
            <button class="tool-btn" onclick="insertMd('*', '*')">Italic</button>
            <button class="tool-btn" onclick="insertMd('> **TL;DR**\n> - ')">Quote</button>
            <button class="tool-btn" onclick="insertMd('| Col 1 | Col 2 |\n|---|---|\n| Data 1 | Data 2 |')">Table</button>
            <button class="tool-btn" onclick="insertMd('```python\n', '\n```')">Code</button>
            <button class="tool-btn" onclick="insertMd('[Link Text](', ')')">Link</button>
          </div>
          <textarea id="post-content" class="editor-textarea" placeholder="# Write your article in Markdown here...

> **TL;DR**
> - Key takeaway 1
> - Key takeaway 2

## Chapter 1: Overview
Content goes here..." oninput="updatePreview()"></textarea>
        </div>

        <!-- Real-time Live Preview -->
        <div class="panel">
          <div class="panel-header">
            <span>Live Article Preview</span>
            <span class="badge-studio" style="font-size:0.65rem;">Rendering Real-time</span>
          </div>
          <div id="preview-output" class="preview-pane"></div>
        </div>

      </div>
    </div>

    <!-- 2. MANAGE POSTS TAB -->
    <div id="tab-posts" class="tab-content">
      <div class="posts-table-card">
        <table class="posts-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Date</th>
              <th>Words</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="posts-list-body">
            <tr>
              <td colspan="5" style="text-align:center; color:var(--text-muted); padding:2rem;">Loading published posts...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3. SETTINGS & GITHUB API TAB -->
    <div id="tab-settings" class="tab-content">
      <div style="max-width: 650px; background:var(--card-bg); border:1px solid var(--border); border-radius:8px; padding:1.5rem;">
        <h3 style="margin-bottom:0.75rem;">GitHub & Vercel 1-Click Auto-Deploy</h3>
        <p style="font-size:0.88rem; color:var(--text-muted); margin-bottom:1.5rem; line-height:1.6;">
          Directly commit new articles to your GitHub repository (<code>pixelperfect050-cloud/ai-tech-safar</code>). Once committed, Vercel automatically deploys the article in ~30 seconds!
        </p>

        <div class="form-group" style="margin-bottom:1rem;">
          <label class="form-label">GitHub Personal Access Token (PAT with repo scope)</label>
          <input type="password" id="gh-token" class="form-input" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" />
          <span style="font-size:0.75rem; color:var(--text-muted); margin-top:0.3rem;">Token is stored locally in your browser only.</span>
        </div>

        <div class="form-group" style="margin-bottom:1.5rem;">
          <label class="form-label">Repository</label>
          <input type="text" id="gh-repo" class="form-input" value="pixelperfect050-cloud/ai-tech-safar" readonly />
        </div>

        <button class="btn btn-primary" onclick="saveGhSettings()">Save Deployment Token</button>
      </div>
    </div>

  </main>

  <!-- Toast Notification -->
  <div id="toast" class="toast">
    <span id="toast-msg">Notification</span>
  </div>

  <script is:inline>
    // Tab switcher
    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      
      const btn = event.currentTarget;
      if (btn) btn.classList.add('active');
      document.getElementById('tab-' + tabId).classList.add('active');

      if (tabId === 'posts') {
        loadExistingPosts();
      }
    }

    // Auto Slug
    function autoSlug() {
      const title = document.getElementById('post-title').value;
      const slug = title.toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
      document.getElementById('post-slug').value = slug;
      updatePreview();
    }

    // Update Live Preview
    function updatePreview() {
      const title = document.getElementById('post-title').value || 'Article Title';
      const content = document.getElementById('post-content').value;
      const preview = document.getElementById('preview-output');
      
      const fullMd = '# ' + title + '\n\n' + content;
      preview.innerHTML = DOMPurify.sanitize(marked.parse(fullMd));
      
      const words = content.trim() ? content.trim().split(/\s+/).length : 0;
      document.getElementById('word-count').textContent = words.toLocaleString() + ' words';
    }

    // Insert Markdown Helpers
    function insertMd(prefix, suffix = '') {
      const textarea = document.getElementById('post-content');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selected = text.substring(start, end);
      
      textarea.value = text.substring(0, start) + prefix + selected + suffix + text.substring(end);
      textarea.focus();
      textarea.selectionStart = start + prefix.length;
      textarea.selectionEnd = start + prefix.length + selected.length;
      updatePreview();
    }

    // Generate Full Frontmatter + Markdown string
    function generateFrontmatterMarkdown() {
      const title = document.getElementById('post-title').value.trim() || 'Untitled Post';
      const desc = document.getElementById('post-desc').value.trim() || title;
      const cat = document.getElementById('post-category').value;
      const hero = document.getElementById('post-hero').value.trim();
      const tags = document.getElementById('post-tags').value.split(',').map(t => '"' + t.trim() + '"').filter(t => t !== '""');
      const feat = document.getElementById('post-featured').checked;
      const author = document.getElementById('post-author').value.trim() || 'AI Tech Safar';
      const today = new Date().toISOString().split('T')[0];
      const content = document.getElementById('post-content').value;

      return '---\n' +
        'title: "' + title.replace(/"/g, '\\"') + '"\n' +
        'description: "' + desc.replace(/"/g, '\\"') + '"\n' +
        'pubDate: ' + today + '\n' +
        'category: "' + cat + '"\n' +
        'tags: [' + tags.join(', ') + ']\n' +
        'heroImage: "' + hero + '"\n' +
        'featured: ' + feat + '\n' +
        'author: "' + author + '"\n' +
        '---\n\n' + content;
    }

    // Copy Markdown
    function copyFullMarkdown() {
      const md = generateFrontmatterMarkdown();
      navigator.clipboard.writeText(md);
      showToast('✅ Complete Markdown with Frontmatter copied!');
    }

    // Download .md file
    function downloadMdFile() {
      const md = generateFrontmatterMarkdown();
      const slug = document.getElementById('post-slug').value.trim() || 'article';
      const blob = new Blob([md], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = slug + '.md';
      a.click();
      URL.revokeObjectURL(url);
      showToast('📥 Downloaded ' + slug + '.md');
    }

    // GitHub Settings
    function saveGhSettings() {
      const token = document.getElementById('gh-token').value.trim();
      localStorage.setItem('gh_token', token);
      showToast('✅ GitHub Token saved locally!');
    }

    // Publish to GitHub / Vercel via GitHub API
    async function publishPost() {
      const token = localStorage.getItem('gh_token');
      const slug = document.getElementById('post-slug').value.trim();
      const title = document.getElementById('post-title').value.trim();

      if (!title || !slug) {
        alert('Please provide an article title and slug!');
        return;
      }

      if (!token) {
        alert('GitHub Token not found! Please go to "GitHub / Vercel API" tab and save your GitHub Personal Access Token for 1-click publishing.');
        switchTab('settings');
        return;
      }

      const btn = document.getElementById('publish-btn');
      btn.disabled = true;
      btn.textContent = 'Publishing to GitHub...';

      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const filePath = 'src/content/blog/' + year + '/' + month + '/' + slug + '.md';
      const md = generateFrontmatterMarkdown();

      try {
        // UTF-8 base64 encoding
        const utf8Bytes = new TextEncoder().encode(md);
        let binaryStr = '';
        utf8Bytes.forEach(b => binaryStr += String.fromCharCode(b));
        const contentB64 = btoa(binaryStr);

        // Check if file already exists to get SHA for update
        let sha = null;
        try {
          const checkRes = await fetch('https://api.github.com/repos/pixelperfect050-cloud/ai-tech-safar/contents/' + filePath, {
            headers: { 'Authorization': 'Bearer ' + token }
          });
          if (checkRes.ok) {
            const data = await checkRes.json();
            sha = data.sha;
          }
        } catch(e) {}

        const body = {
          message: 'Publish post: ' + title,
          content: contentB64
        };
        if (sha) body.sha = sha;

        const putRes = await fetch('https://api.github.com/repos/pixelperfect050-cloud/ai-tech-safar/contents/' + filePath, {
          method: 'PUT',
          headers: {
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
            'Accept': 'application/vnd.github.v3+json'
          },
          body: JSON.stringify(body)
        });

        if (putRes.ok) {
          showToast('🚀 Published! Vercel is now building the article live.');
          alert('Success! Post published to ' + filePath + '.\nVercel will auto-deploy it in 30 seconds!');
        } else {
          const err = await putRes.json();
          alert('GitHub API Error: ' + err.message);
        }
      } catch(err) {
        alert('Failed to publish: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Publish to Vercel';
      }
    }

    // Load Existing Posts
    let cachedPosts = [];
    async function loadExistingPosts() {
      try {
        const res = await fetch('/export.json');
        const data = await res.json();
        cachedPosts = data.posts || [];
        document.getElementById('post-count-badge').textContent = cachedPosts.length;
        
        const tbody = document.getElementById('posts-list-body');
        tbody.innerHTML = cachedPosts.map((post, idx) => `
          <tr>
            <td>
              <div class="post-table-title">${post.title}</div>
              <div style="font-size:0.75rem; color:var(--text-muted);">${post.id}.md</div>
            </td>
            <td><span class="badge-studio" style="font-size:0.7rem;">${post.category}</span></td>
            <td style="color:var(--text-muted); font-size:0.85rem;">${post.pubDate.split('T')[0]}</td>
            <td style="color:var(--text-muted); font-size:0.85rem;">${post.body ? post.body.split(/\s+/).length : 0}</td>
            <td>
              <div style="display:flex; gap:0.4rem;">
                <button class="btn btn-secondary" style="padding:0.3rem 0.6rem; font-size:0.75rem;" onclick="loadPostIntoEditor(${idx})">Edit in Composer</button>
                <a href="${post.url}" target="_blank" class="btn btn-secondary" style="padding:0.3rem 0.6rem; font-size:0.75rem; text-decoration:none;">View</a>
              </div>
            </td>
          </tr>
        `).join('');
      } catch(e) {
        console.error('Failed to load posts', e);
      }
    }

    // Load post into composer
    function loadPostIntoEditor(index) {
      const p = cachedPosts[index];
      if (!p) return;
      document.getElementById('post-title').value = p.title;
      document.getElementById('post-slug').value = p.slug;
      document.getElementById('post-category').value = p.category;
      document.getElementById('post-hero').value = p.heroImage || '';
      document.getElementById('post-desc').value = p.description || '';
      document.getElementById('post-tags').value = (p.tags || []).join(', ');
      document.getElementById('post-featured').checked = p.featured || false;
      document.getElementById('post-author').value = p.author || 'AI Tech Safar';
      document.getElementById('post-content').value = p.body || '';
      switchTab('composer');
      updatePreview();
      showToast('Post loaded into Composer!');
    }

    // Toast helper
    function showToast(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toast-msg').textContent = msg;
      t.style.display = 'flex';
      setTimeout(() => t.style.display = 'none', 3000);
    }

    // Init
    window.addEventListener('DOMContentLoaded', () => {
      const token = localStorage.getItem('gh_token');
      if (token) document.getElementById('gh-token').value = token;
      updatePreview();
    });
  </script>
</body>
</html>
