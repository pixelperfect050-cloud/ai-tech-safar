  // -------------------------------------------------------------------
  // SLIDE-OVER DRAWER / MODAL FUNCTIONS
  // -------------------------------------------------------------------
  function openDrawer(docId) {
    const doc = storedDocuments[docId];
    if (!doc) return;
    currentDrawerDoc = doc;
    document.getElementById('drawer-doc-title').textContent = doc.title;
    document.getElementById('drawer-doc-body').innerHTML = DOMPurify.sanitize(doc.html);
    document.getElementById('drawer-stats').textContent = `${doc.words.toLocaleString()} words • Ready to Publish`;
    document.getElementById('doc-drawer').classList.add('open');
  }

  function closeDrawer() {
    document.getElementById('doc-drawer').classList.remove('open');
  }

  function copyDrawerMarkdown() {
    if (currentDrawerDoc && currentDrawerDoc.markdown) {
      navigator.clipboard.writeText(currentDrawerDoc.markdown);
      alert('Markdown copied to clipboard!');
    }
  }

  function copyDrawerHtml() {
    const b = document.getElementById('drawer-doc-body').innerHTML;
    if (b) {
      navigator.clipboard.writeText(b);
      alert('HTML copied to clipboard!');
    }
  }

  function downloadDrawerMarkdown() {
    if (!currentDrawerDoc) return;
    const blob = new Blob([currentDrawerDoc.markdown], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${currentDrawerDoc.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}.md`;
    a.click();
    URL.revokeObjectURL(url);
  }
